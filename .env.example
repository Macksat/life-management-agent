# Personal Action OS Template — 環境変数テンプレート
# 実際の値は .env に書く(.env は .gitignore 済み。絶対にコミットしない)。
# cp .env.example .env して値を埋める。

# --- Google Workspace (OAuth 2.0 クライアント) ---
# Google Cloud Console > APIとサービス > 認証情報 で作成した OAuth クライアント。
# 種類は「ウェブ アプリケーション」、リダイレクト URI に http://localhost:8000/oauth2callback を登録。
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# 任意: workspace-mcp が公開する HTTP/コールバックのベース。既定は http://localhost:8000
# WORKSPACE_MCP_BASE_URI=http://localhost
# WORKSPACE_MCP_PORT=8000

# --- GitHub MCP (Issue CRUD) ---
# GitHub > Settings > Developer settings > Personal access tokens (Fine-grained) で発行。
# 必要なスコープ: repo, read:org
GITHUB_PERSONAL_ACCESS_TOKEN=your-github-personal-access-token

# --- 任意: 他サービス(リポジトリでは未使用。連携する場合のみ) ---
# SLACK_BOT_TOKEN=
# ANTHROPIC_API_KEY=
