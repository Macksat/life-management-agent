{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/personal-action-os-template/schemas/review.schema.json",
  "title": "Review",
  "description": "AI エージェントのレビュー / 評価結果を機械可読に表す。evals/ の基準に対応。",
  "type": "object",
  "required": ["review_type", "target", "date", "overall", "criteria"],
  "properties": {
    "review_type": {
      "type": "string",
      "enum": [
        "issue_quality",
        "task_breakdown",
        "prioritization",
        "agent_behavior",
        "daily_review",
        "weekly_review"
      ]
    },
    "target": {
      "type": "string",
      "description": "対象。Issue 番号(#123)、期間、または対象の説明。"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "YYYY-MM-DD。"
    },
    "reviewer": {
      "type": "string",
      "enum": ["ai", "human"],
      "default": "ai"
    },
    "overall": {
      "type": "string",
      "enum": ["pass", "needs-work", "fail"]
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "score"],
        "properties": {
          "name": { "type": "string" },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2,
            "description": "0=不可, 1=一部, 2=良い"
          },
          "comment": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": { "type": "string" },
      "description": "指摘事項。"
    },
    "recommended_actions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "改善のための具体アクション。"
    }
  },
  "additionalProperties": false
}
